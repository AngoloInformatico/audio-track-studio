# Override facoltativi per sviluppo. Per l'uso normale seguire README_GUIDA.md#configurazione-guidata-acoustid.
# Mantieni chiavi reali e valori specifici del PC soltanto nel file locale .env, ignorato da Git.
ATS_FFMPEG_BINARY=ffmpeg
ATS_FFPROBE_BINARY=ffprobe
ATS_FPCALC_BINARY=fpcalc
ATS_EXPORT_DIR=C:\Users\nomeutente\Music\Audio Track Studio
ATS_DATA_DIR=C:\Users\nomeutente\AppData\Local\AudioTrackStudio

# Application API Key AcoustID. Non inserire mai una chiave reale nel repository.
ACOUSTID_API_KEY=

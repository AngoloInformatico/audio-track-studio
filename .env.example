# Optional overrides. Keep real keys and machine-specific values in .env.
ATS_FFMPEG_BINARY=ffmpeg
ATS_FFPROBE_BINARY=ffprobe
ATS_FPCALC_BINARY=fpcalc
ATS_EXPORT_DIR=C:\Users\nomeutente\Music\Audio Track Studio
ATS_DATA_DIR=C:\Users\nomeutente\AppData\Local\AudioTrackStudio

# Chiave applicazione AcoustID. Non inserire mai una chiave reale nel repository.
ACOUSTID_API_KEY=
